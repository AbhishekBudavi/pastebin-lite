# Environment Variables Template
# Copy this file to .env.local and fill in your values

# =====================================
# Database Configuration
# =====================================
# For Vercel Postgres: Copy from Vercel Dashboard > Storage > Postgres > Connection string
# For Local PostgreSQL: postgres://user:password@localhost:5432/database_name
POSTGRES_URL=postgres://postgres:0707@localhost:5432/pastebin_lite

# =====================================
# Frontend URL Configuration - IMPORTANT!
# =====================================
# This is used to generate shareable paste links in API responses
# 
# For LOCAL DEVELOPMENT:
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# For VERCEL PRODUCTION (replace YOUR-PROJECT with your actual Vercel project name):
#   NEXT_PUBLIC_APP_URL=https://your-project-name.vercel.app
#
# For CUSTOM DOMAIN:
#   NEXT_PUBLIC_APP_URL=https://your-custom-domain.com
#
# If not set, the API will auto-detect from request headers (preferred for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================
# Node Environment
# =====================================
NODE_ENV=development
